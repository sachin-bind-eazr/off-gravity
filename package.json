    "next": "^15.5.29",
    "otplib": "^13.6.0",
    "pdfkit": "^0.20.2",
    "pg-boss": "^12.38.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
