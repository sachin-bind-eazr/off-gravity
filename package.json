    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "imagetracerjs": "^1.2.6",
    "mapshaper": "^0.8.1",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
